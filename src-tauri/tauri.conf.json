{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zarc",
  "version": "0.1.1",
  "identifier": "com.zarc.archiver",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zarc",
        "width": 900,
        "height": 600,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "installMode": "perMachine"
      }
    },
    "fileAssociations": [
      {
        "ext": ["zip"],
        "name": "Zip Archive",
        "description": "Zip archive, opened with Zarc"
      },
      {
        "ext": ["7z"],
        "name": "7-Zip Archive",
        "description": "7z archive, opened with Zarc"
      }
    ]
  }
}
